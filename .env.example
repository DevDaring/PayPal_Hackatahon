# QuoteGuard configuration. Copy to .env and fill in. Never commit .env.
APP_ENV=local                      # local | test | hosted
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8251
DATABASE_URL=postgresql+psycopg://quoteguard:CHANGE_ME@localhost:5443/quoteguard_dev
SESSION_SECRET=                    # >=32 random chars, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
APPROVAL_SIGNING_SECRET=           # >=32 random chars, different from SESSION_SECRET
CORS_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false                # true behind HTTPS
DEFAULT_TIMEZONE=Asia/Kolkata
STORAGE_PATH=./storage             # private directory, never under a public web root
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=20

# AI: any OpenAI-compatible endpoint (OpenAI, OpenRouter, Gemini's /v1beta/openai).
AI_PROVIDER=gemini                 # gemini | openai | openrouter | none
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=                        # comma-separated keys are rotated on rate limits
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=45
AI_MAX_TOKENS=4000
AI_MAX_CALLS_PER_REQUEST=24
OCR_PROVIDER=                      # gemini to enable vision OCR for image-only PDFs; blank = ask for a text PDF
OCR_API_KEY=
OCR_MODEL=

# PayPal — sandbox only (live mode is rejected at startup).
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=                # sandbox business account payer ID; checked against each order's payee
PAYPAL_WEBHOOK_ID=                 # from `python -m quoteguard.cli register-webhook https://<host>/api/v1/webhooks/paypal`
PAYMENT_CURRENCY=USD
APPROVAL_TTL_MINUTES=60

# Demo
DEMO_MODE=true
DEMO_LAB_ENABLED=true
DEMO_ACCOUNT_USERNAME=             # shared jury login; each sign-in gets an isolated demo workspace
DEMO_ACCOUNT_PASSWORD=
SHOW_JURY_LOGIN=false              # true shows the demo login on the sign-in page
DEMO_REQUESTER_EMAIL=
DEMO_REQUESTER_PASSWORD=
DEMO_APPROVER_EMAIL=
DEMO_APPROVER_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
SANDBOX_BUYER_EMAIL=               # optional PayPal *sandbox* personal account shown on checkout
SANDBOX_BUYER_PASSWORD=

MOCK_AI=false                      # true = deterministic extractor only (tests/walkthrough)
MOCK_PAYPAL=false                  # true = labelled simulated provider; never use for sandbox proof
LOG_LEVEL=INFO
AG_GRID_LICENSE_KEY=               # not needed: only AG Grid Community features are used
